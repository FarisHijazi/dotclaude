{
  "__comment": "DEPLOYED to prod Grafana 2026-07-09 as uid=dfc-activity in the Operations folder (http://10.100.20.15:3000/d/dfc-activity). Loki datasource uid=bf28onennottsf; derived fields (grafana/loki-derived-fields.json) are also applied so request_id/supervisor_id/miner_ip are clickable. This file mirrors the live version — to re-import elsewhere: POST /api/dashboards/db {dashboard:<this minus __comment>, folderUid, overwrite:true}. Activity/Faults panels use `| json | line_format` for clean one-liners (addresses log verbosity); drill-down panels keep raw JSON (prettified) so allocation dicts + derived-field links show.",
  "uid": "dfc-activity",
  "title": "DFC — Fleet Activity & Dispatch",
  "tags": ["dfc", "fleet", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      { "name": "request_id", "type": "textbox", "label": "request_id (sfp-/sac-/wac-/sup-)", "query": "", "current": { "text": "", "value": "" } }
    ]
  },
  "panels": [
    { "type": "row", "title": "Site activity — every state change (~8/h)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 1 },
    { "type": "stat", "title": "Dispatches (sfp) 24h", "id": 10, "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 }, "datasource": { "type": "loki", "uid": "bf28onennottsf" }, "targets": [ { "refId": "A", "expr": "sum(count_over_time({module=\"fleet\"} |= `Fleet power distribution completed` [$__range]))", "queryType": "instant" } ], "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" } },
    { "type": "stat", "title": "Curtailments (sac) 24h", "id": 11, "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 }, "datasource": { "type": "loki", "uid": "bf28onennottsf" }, "targets": [ { "refId": "A", "expr": "sum(count_over_time({module=\"fleet\"} |= `Sleep-all completed` [$__range]))", "queryType": "instant" } ], "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" } },
    { "type": "stat", "title": "Autonomous surplus (sup) 24h", "id": 12, "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 }, "datasource": { "type": "loki", "uid": "bf28onennottsf" }, "targets": [ { "refId": "A", "expr": "sum(count_over_time({module=\"fleet\"} |= `surplus power redistribution completed` [$__range]))", "queryType": "instant" } ], "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] } } }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" } },
    { "type": "stat", "title": "Meter<breakers fault 24h", "id": 13, "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 }, "datasource": { "type": "loki", "uid": "bf28onennottsf" }, "targets": [ { "refId": "A", "expr": "sum(count_over_time({module=\"fleet\"} |= `Site meter reads below` [$__range]))", "queryType": "instant" } ], "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" } },
    { "type": "stat", "title": "Rejections/clamps 24h", "id": 14, "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 }, "datasource": { "type": "loki", "uid": "bf28onennottsf" }, "targets": [ { "refId": "A", "expr": "sum(count_over_time({module=~\"fleet|grid_actor|supervisor\"} |~ `rejected|Refusing|exceeds (controller|global)` != `Token` [$__range]))", "queryType": "instant" } ], "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] } } }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" } },
    { "type": "logs", "title": "Activity Log — fleet + gateway state changes (click a line to expand)", "id": 20, "gridPos": { "h": 12, "w": 24, "x": 0, "y": 5 }, "datasource": { "type": "loki", "uid": "bf28onennottsf" }, "targets": [ { "refId": "A", "queryType": "range", "expr": "{module=~`fleet|grid_actor`} != `command updated` != `dispatch active` != `health failure notification` != `health recovery notification` != `Site meter reads below` | json | line_format `{{.message}}{{if .request_id}}  ·  {{.request_id}}{{end}}{{if .miner_ip}}  [{{.miner_ip}}]{{end}}`" } ], "options": { "showTime": true, "wrapLogMessage": true, "dedupStrategy": "none", "sortOrder": "Descending", "enableLogDetails": true } },
    { "type": "row", "title": "Faults & autonomous behavior (the surprises)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }, "id": 2 },
    { "type": "logs", "title": "WARN/ERROR + surplus / reconcile / rejection", "id": 30, "gridPos": { "h": 10, "w": 24, "x": 0, "y": 18 }, "datasource": { "type": "loki", "uid": "bf28onennottsf" }, "targets": [ { "refId": "A", "queryType": "range", "expr": "{application=`control_service`} |~ `Site meter reads below|surplus power|Reconciled power_setpoint|Refusing set_fleet|exceeds (controller|global)|Failed to set power setpoint` != `health` | json | line_format `{{.message}}{{if .request_id}}  ·  {{.request_id}}{{end}}{{if .miner_ip}}  [{{.miner_ip}}]{{end}}`" } ], "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true } },
    { "type": "row", "title": "Dispatch drill-down — paste a request_id above (allocations shown as JSON)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 }, "id": 3 },
    { "type": "logs", "title": "Per-supervisor allocation (power_allocations)", "id": 40, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 }, "datasource": { "type": "loki", "uid": "bf28onennottsf" }, "targets": [ { "refId": "A", "queryType": "range", "expr": "{module=`fleet`} |= `$request_id` |= `distribution completed`" } ], "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "prettifyLogMessage": true } },
    { "type": "logs", "title": "Per-miner allocation (miner_targets)", "id": 41, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 }, "datasource": { "type": "loki", "uid": "bf28onennottsf" }, "targets": [ { "refId": "A", "queryType": "range", "expr": "{module=`supervisor`} |= `$request_id` |= `Group power distribution completed`" } ], "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "prettifyLogMessage": true } },
    { "type": "logs", "title": "Whole dispatch chain ($request_id) — request_id / miner_ip are clickable", "id": 42, "gridPos": { "h": 12, "w": 24, "x": 0, "y": 37 }, "datasource": { "type": "loki", "uid": "bf28onennottsf" }, "targets": [ { "refId": "A", "queryType": "range", "expr": "{application=`control_service`} |= `$request_id`" } ], "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Ascending", "enableLogDetails": true, "prettifyLogMessage": true } },
    { "type": "row", "title": "Volume by module (noise floor)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 49 }, "id": 4 },
    { "type": "timeseries", "title": "Lines/sec by module", "id": 50, "gridPos": { "h": 8, "w": 24, "x": 0, "y": 50 }, "datasource": { "type": "loki", "uid": "bf28onennottsf" }, "targets": [ { "refId": "A", "expr": "sum by (module) (rate({environment=`production`}[$__interval]))", "legendFormat": "{{module}}" } ] }
  ]
}
